# Template for the per-build CMakeCarbonCompiler.cmake that
# CMakeDetermineCarbonCompiler.cmake writes into CMakeFiles/<version>/.
set(CMAKE_Carbon_COMPILER "@CMAKE_Carbon_COMPILER@")
set(CMAKE_Carbon_COMPILER_ARG1 "@CMAKE_Carbon_COMPILER_ARG1@")
set(CMAKE_Carbon_COMPILER_ID "@CMAKE_Carbon_COMPILER_ID@")
set(CMAKE_Carbon_COMPILER_VERSION "@CMAKE_Carbon_COMPILER_VERSION@")
set(CMAKE_Carbon_INSTALL_ROOT "@CMAKE_Carbon_INSTALL_ROOT@")
set(CMAKE_Carbon_LLVM_BINDIR "@CMAKE_Carbon_LLVM_BINDIR@")
set(CMAKE_Carbon_COMPILER_AR "@CMAKE_Carbon_COMPILER_AR@")
set(CMAKE_Carbon_COMPILER_RANLIB "@CMAKE_Carbon_COMPILER_RANLIB@")
set(CMAKE_AR "@CMAKE_AR@")
set(CMAKE_RANLIB "@CMAKE_RANLIB@")
set(CMAKE_LINKER "@CMAKE_LINKER@")
set(CMAKE_Carbon_COMPILER_LOADED 1)
set(CMAKE_Carbon_COMPILER_WORKS @CMAKE_Carbon_COMPILER_WORKS@)
set(CMAKE_Carbon_COMPILER_ENV_VAR "CARBON")

set(CMAKE_Carbon_COMPILER_ID_RUN 1)
# CMake keys on the last extension, so `.impl.carbon` files are "carbon" too.
set(CMAKE_Carbon_SOURCE_FILE_EXTENSIONS carbon)
set(CMAKE_Carbon_IGNORE_EXTENSIONS h;H;o;O;obj;OBJ;def;DEF;rc;RC)
# Higher than CXX (30) and propagating through static libraries, so a mixed
# Carbon/C++ executable is linked by `carbon link`, which supplies the Carbon
# prelude objects and the runtimes.
set(CMAKE_Carbon_LINKER_PREFERENCE 40)
set(CMAKE_Carbon_LINKER_PREFERENCE_PROPAGATES 1)
