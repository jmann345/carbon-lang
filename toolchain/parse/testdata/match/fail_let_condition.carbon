// `match (let ...)` is not a pattern condition (W-012): the `let`/`var` peek
// in `HandleParenCondition` applies to `if` and `while` only, so `match`
// takes the expression path and `let` is an expected-expression error, as
// before W-012.
fn F(x: i32) -> i32 {
  // CHECK:STDERR: fail_let_condition.carbon:[[@LINE+8]]:10: error: expected expression [ExpectedExpr]
  // CHECK:STDERR:   match (let n: i32 = x) {
  // CHECK:STDERR:          ^~~
  // CHECK:STDERR:
  // CHECK:STDERR: fail_let_condition.carbon:[[@LINE+4]]:10: error: unexpected tokens before `)` [ExpectedCloseSymbol]
  // CHECK:STDERR:   match (let n: i32 = x) {
  // CHECK:STDERR:          ^~~
  // CHECK:STDERR:
  match (let n: i32 = x) {
    default => { return 0; }
  }
  return 1;
}

